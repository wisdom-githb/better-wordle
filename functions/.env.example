# Copy to .env or .env.<projectId> and set values.
# STRIPE_PRICE_ID is required for gift checkout (e.g. price_1Stdu50s95qSLn7SYt1qcvNa).
# Secrets (STRIPE_SECRET_KEY, STRIPE_GIFT_WEBHOOK_SECRET) are set via:
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_GIFT_WEBHOOK_SECRET
STRIPE_PRICE_ID=price_xxxx
